# =============================================================================
# DigitalizaTusNegocios AI OS — environment template
#
# Copy to `.env` for development. NEVER commit real values.
# Staging/production values live in the hosting provider's secret manager
# (Vercel env vars, VPS secrets, GitHub Actions secrets), never in files.
#
# APP_ENV: development | test | staging | production
#   - staging/production refuse to boot without Supabase, DATABASE_URL and
#     SECRETS_ENCRYPTION_KEYS, and forbid ALLOW_INSECURE_OUTBOUND.
# =============================================================================

APP_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Supabase ---------------------------------------------------------------
# Local: run `supabase start` and copy the values it prints.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS: only used by webhooks/worker with explicit tenant filters.
SUPABASE_SERVICE_ROLE_KEY=
# Local Supabase default: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# --- Secrets encryption (integration credentials, OAuth tokens) -------------
# Comma-separated "version:base64key" list; the LAST key encrypts, all decrypt.
# Generate a key with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEYS=

# --- LLM providers (configure at least one) ----------------------------------
# Missing keys simply disable that provider in the router.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# Optional base URL overrides (e.g. a LiteLLM proxy): OPENAI_BASE_URL=...

# Defaults used by templates, format "provider:model".
DEFAULT_CHAT_MODEL=
# Must produce vectors of EMBEDDING_DIMENSIONS size (matches the DB column).
DEFAULT_EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- WhatsApp Cloud API (Meta) ----------------------------------------------
# App-level values. Per-client access tokens are stored encrypted in the DB.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Webhook to register in the Meta app: {APP_URL}/api/webhooks/whatsapp
# Optional override (tests use a local double): default https://graph.facebook.com/v21.0
WHATSAPP_GRAPH_BASE_URL=

# --- Email channel -------------------------------------------------------------
# Each client stores its own Resend API key in Integrations → Credentials.
# Replies are drafts unless the client explicitly enables auto-send per channel.
# Optional override (tests use a local double): default https://api.resend.com
RESEND_BASE_URL=

# --- Calendar OAuth ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# --- Outbound HTTP safety ------------------------------------------------------
# true allows http:// and private IPs for outbound calls (local testing only).
ALLOW_INSECURE_OUTBOUND=false

# --- Observability (optional) ---------------------------------------------------
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
